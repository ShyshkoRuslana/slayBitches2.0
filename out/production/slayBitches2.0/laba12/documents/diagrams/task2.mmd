classDiagram
    direction TB

    class SeatCategory {
        <<Flyweight>>
        -String name
        -String description
        -int chairWidthCm
        -String iconPath
        -double basePrice
        +SeatCategory(name: String, description: String, chairWidthCm: int, iconPath: String, basePrice: double)
        +getName() String
        +getDetails() String
    }

    class SeatCategoryFactory {
        <<FlyweightFactory>>
        -Map~String, SeatCategory~ categories$
        +getCategory(type: String)$ SeatCategory
        +getCreatedCategoriesCount()$ int
    }

    class Seat {
        <<Context>>
        -int sessionId
        -int row
        -int number
        -boolean isSold
        -SeatCategory category
        +Seat(sessionId: int, row: int, number: int, isSold: boolean, category: SeatCategory)
        +getCategory() SeatCategory
        +getFullDescription() String
    }

    class Main {
        <<Client>>
        +main(args: String[])$ void
    }

    class EventLogger {
        -DateTimeFormatter TIME_FMT$
        +log(source: String, event: String)$ void
    }

    SeatCategoryFactory o--> "0..*" SeatCategory : caches
    Seat --> "1" SeatCategory : shares
    Main ..> SeatCategoryFactory : requests category
    Main ..> Seat : creates
    SeatCategory ..> EventLogger : logs
    Main ..> EventLogger : logs