classDiagram
    class CinemaCashDesk {
        <<Client>>
        -String deskName
        -IPaymentProcessor paymentProcessor
        +CinemaCashDesk(String deskName, IPaymentProcessor processor)
        +setPaymentProcessor(IPaymentProcessor processor) void
        +sellTicket(String movieTitle, double priceUah) void
    }

    class IPaymentProcessor {
        <<Target Interface>>
        +processPayment(double amountInUah)* PaymentResult
    }

    class PaymentResult {
        <<Data Transfer Object>>
        -boolean isSuccess
        -String message
        +isSuccess() boolean
        +message() String
    }

    class BankTerminalAdapter {
        <<Adapter>>
        -BankTerminalApi terminal
        +BankTerminalAdapter(BankTerminalApi terminal)
        +processPayment(double amountInUah) PaymentResult
        -mapResponseCode(int code) PaymentResult
    }

    class BankTerminalApi {
        <<Adaptee>>
        -String terminalId
        -boolean simulateDecline
        +BankTerminalApi(String terminalId)
        +setSimulateDecline(boolean simulateDecline) void
        +makeTransaction(int amountInKopecks) int
    }

    CinemaCashDesk "1" --> "1" IPaymentProcessor : uses
    BankTerminalAdapter ..|> IPaymentProcessor : implements
    BankTerminalAdapter "1" o-- "1" BankTerminalApi : wraps
    IPaymentProcessor ..> PaymentResult : returns